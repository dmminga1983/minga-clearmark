# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# Require "Authorization: Bearer <key>" on the HTTP service. Leave unset to
# disable auth (fine only for a service bound to 127.0.0.1 / a trusted network).
CLEARMARK_API_KEY=

# Force a message language for the CLI/server instead of auto-detecting the
# system locale. One of: en, ru.
CLEARMARK_LANG=
